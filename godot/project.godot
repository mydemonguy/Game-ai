; Aetherfall — Godot 4 project. Open this folder (or import project.godot) in the Godot 4.6 editor.

config_version=5

[application]

config/name="Aetherfall"
config/description="A Starblood saga: one small dino, six worlds, one very big Rift."
config/version="4.11"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.027, 0.024, 0.059, 1)
boot_splash/show_image=false
run/max_fps=60

[autoload]

DB="*res://scripts/db.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.024, 0.059, 1)
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=false

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/confusable_local_declaration=0

[importer_defaults]

texture={
"compress/lossy_quality": 0.82,
"compress/mode": 1
}
